# Reproduction (verified 2026-11-06):
#   python3 -m venv venv && venv/bin/pip install glad2==2.0.8   (pulls Jinja2 3.1.6, MarkupSafe 3.0.4)
#   venv/bin/glad --api='gl:core=3.3' --extensions='' --out-path out --reproducible c --loader
#   (cd out && patch -p1 < third_party/glad/patches/0001-gl-c-local-adjustments.patch)
# gl.h, khrplatform.h and gl.c then match the committed files byte for byte, except
# the "Loader generated by glad 2.0.8 on <time>" line in gl.h. --reproducible uses the
# gl.xml bundled in the wheel; generating against the live Khronos spec on 2026-11-06
# gave identical output.
set(PIXCAKE_GLAD_PIP_PACKAGE "glad2==2.0.8")
