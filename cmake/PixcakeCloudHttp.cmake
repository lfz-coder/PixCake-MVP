include_guard(GLOBAL)
if(NOT APPLE)
  message(FATAL_ERROR "Cloud HTTPS currently requires the macOS SDK system libcurl; other platforms need a reviewed adapter")
endif()
include(${CMAKE_SOURCE_DIR}/third_party/nlohmann-json.lock.cmake)

function(pixcake_cloud_download url destination checksum)
  if(EXISTS "${destination}")
    file(SHA256 "${destination}" actual)
    if(NOT actual STREQUAL checksum)
      message(FATAL_ERROR "Cloud dependency checksum mismatch: ${destination}")
    endif()
  else()
    get_filename_component(parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(DOWNLOAD "${url}" "${destination}" EXPECTED_HASH "SHA256=${checksum}"
         TLS_VERIFY ON TIMEOUT 180 STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "Could not download locked cloud dependency: ${status}")
    endif()
  endif()
endfunction()

set(json_root "${CMAKE_BINARY_DIR}/third_party/nlohmann_json-${PIXCAKE_JSON_VERSION}")
pixcake_cloud_download("${PIXCAKE_JSON_HEADER_URL}" "${json_root}/include/nlohmann/json.hpp" "${PIXCAKE_JSON_HEADER_SHA256}")
pixcake_cloud_download("${PIXCAKE_JSON_LICENSE_URL}" "${json_root}/LICENSE.MIT" "${PIXCAKE_JSON_LICENSE_SHA256}")
add_library(nlohmann_json::nlohmann_json INTERFACE IMPORTED GLOBAL)
set_target_properties(nlohmann_json::nlohmann_json PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${json_root}/include")
configure_file("${json_root}/LICENSE.MIT" "${CMAKE_BINARY_DIR}/third_party_notices/nlohmann_json/LICENSE.MIT" COPYONLY)

# Never resolve a developer's unpinned Homebrew curl/TLS implementation.
set(cloud_sdk "${CMAKE_OSX_SYSROOT}")
if(NOT IS_DIRECTORY "${cloud_sdk}")
  execute_process(COMMAND xcrun --sdk macosx --show-sdk-path OUTPUT_VARIABLE cloud_sdk
                  OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
endif()
find_path(PIXCAKE_SYSTEM_CURL_INCLUDE curl/curl.h PATHS "${cloud_sdk}/usr/include" NO_DEFAULT_PATH REQUIRED)
find_library(PIXCAKE_SYSTEM_CURL_LIBRARY curl PATHS "${cloud_sdk}/usr/lib" NO_DEFAULT_PATH REQUIRED)
file(REAL_PATH "${cloud_sdk}/usr/include" sdk_include)
file(REAL_PATH "${cloud_sdk}/usr/lib" sdk_library)
file(REAL_PATH "${PIXCAKE_SYSTEM_CURL_INCLUDE}" actual_include)
get_filename_component(curl_library_directory "${PIXCAKE_SYSTEM_CURL_LIBRARY}" DIRECTORY)
file(REAL_PATH "${curl_library_directory}" actual_library)
if(NOT actual_include STREQUAL sdk_include OR NOT actual_library STREQUAL sdk_library)
  message(FATAL_ERROR "Cloud HTTPS curl cache paths must resolve inside the selected macOS SDK")
endif()
file(READ "${PIXCAKE_SYSTEM_CURL_INCLUDE}/curl/curlver.h" curl_version_header)
string(REGEX MATCH "#define LIBCURL_VERSION \"([^\"]+)\"" matched "${curl_version_header}")
set(cloud_curl_version "${CMAKE_MATCH_1}")
if(NOT cloud_curl_version OR cloud_curl_version VERSION_LESS "8.7.1")
  message(FATAL_ERROR "Cloud HTTPS requires macOS SDK libcurl headers >= 8.7.1")
endif()
message(STATUS "Cloud HTTPS: macOS SDK libcurl ${cloud_curl_version}, locked nlohmann/json ${PIXCAKE_JSON_VERSION}")
add_library(CURL::libcurl UNKNOWN IMPORTED GLOBAL)
set_target_properties(CURL::libcurl PROPERTIES IMPORTED_LOCATION "${PIXCAKE_SYSTEM_CURL_LIBRARY}"
  INTERFACE_INCLUDE_DIRECTORIES "${PIXCAKE_SYSTEM_CURL_INCLUDE}")
