# PixCake Agent sidecar.  Do not commit real credentials.
PIXCAKE_GATEWAY_URL=http://127.0.0.1:27461
# Release builds prefer the per-user 0600 Unix socket owned by the PixCake app.
# Leave empty while using the HTTP development gateway above.
PIXCAKE_GATEWAY_SOCKET=
PIXCAKE_GATEWAY_TOKEN=
PIXCAKE_AGENT_FIXTURE=1
PIXCAKE_AGENT_MAX_STEPS=12
PIXCAKE_GATEWAY_TIMEOUT=30

# Set by PixCake when it owns the local main-process listener. If omitted, the
# app creates a per-process user socket when PIXCAKE_ASSISTANT_EXECUTABLE is set.
# PIXCAKE_ASSISTANT_SOCKET=/tmp/pixcake-assistant.sock
# PIXCAKE_ASSISTANT_ID=assistant
# PIXCAKE_ASSISTANT_URL=http://127.0.0.1:27461/threads/{thread_id}/runs/stream

# Production model configuration is supplied by the deployment environment.
PIXCAKE_MODEL_PROVIDER=deepseek
PIXCAKE_MODEL_NAME=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
