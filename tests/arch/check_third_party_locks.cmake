# 测试清单 T-22、安全清单 S-34：仓库内第三方源码、补丁和许可证文本必须与锁定文件中的 SHA-256 一致，
# 发布前阻塞项必须为空。任何一项不一致即失败（防止生成文件或许可证文本被悄悄改动）。
include(${SOURCE_DIR}/third_party/glad.lock.cmake)
include(${SOURCE_DIR}/third_party/litert.lock.cmake)
include(${SOURCE_DIR}/third_party/models.lock.cmake)
include(${SOURCE_DIR}/third_party/onnxruntime.lock.cmake)
include(${SOURCE_DIR}/third_party/nlohmann-json.lock.cmake)

set(failures "")
macro(check_sha path expected)
  if(NOT EXISTS "${SOURCE_DIR}/${path}")
    string(APPEND failures "missing ${path}\n")
  elseif("${expected}" STREQUAL "")
    string(APPEND failures "no locked SHA-256 for ${path}\n")
  else()
    file(SHA256 "${SOURCE_DIR}/${path}" actual)
    if(NOT actual STREQUAL "${expected}")
      string(APPEND failures "${path}: ${actual} != locked ${expected}\n")
    endif()
  endif()
endmacro()

check_sha(third_party/glad/include/glad/gl.h "${PIXCAKE_GLAD_SHA256_GL_H}")
check_sha(third_party/glad/include/KHR/khrplatform.h "${PIXCAKE_GLAD_SHA256_KHRPLATFORM_H}")
check_sha(third_party/glad/src/gl.c "${PIXCAKE_GLAD_SHA256_GL_C}")
check_sha(third_party/glad/patches/0001-gl-c-local-adjustments.patch "${PIXCAKE_GLAD_SHA256_PATCH_0001}")
check_sha(third_party/glad/LICENSES/Apache-2.0.txt "${PIXCAKE_GLAD_SHA256_LICENSE_APACHE}")
check_sha(third_party/glad/LICENSES/CC0-1.0.txt "${PIXCAKE_GLAD_SHA256_LICENSE_CC0}")
if(NOT "${PIXCAKE_GLAD_RELEASE_BLOCKERS}" STREQUAL "")
  string(APPEND failures "glad release blockers remain: ${PIXCAKE_GLAD_RELEASE_BLOCKERS}\n")
endif()

# LiteRT and models: licence texts in the repository, pinned sources, no "latest" URLs.
check_sha(third_party/litert/LICENSES/LiteRT-LICENSE.txt "${PIXCAKE_LITERT_SHA256_LICENSE}")
check_sha(third_party/models/LICENSES/Apache-2.0.txt "${PIXCAKE_MODELS_SHA256_LICENSE_APACHE}")
macro(check_pin name url sha)
  string(LENGTH "${sha}" sha_length)
  if(NOT "${sha}" MATCHES "^[0-9a-f]+$" OR NOT sha_length EQUAL 64)
    string(APPEND failures "${name}: SHA-256 is not 64 lowercase hex digits\n")
  endif()
  if("${url}" STREQUAL "" OR "${url}" MATCHES "/latest/" OR NOT "${url}" MATCHES "^https://")
    string(APPEND failures "${name}: URL must be an https URL to a fixed version: ${url}\n")
  endif()
endmacro()
check_pin(litert "${PIXCAKE_LITERT_SOURCE_URL}" "${PIXCAKE_LITERT_SOURCE_SHA256}")
check_pin(nlohmann-json "${PIXCAKE_JSON_HEADER_URL}" "${PIXCAKE_JSON_HEADER_SHA256}")
check_pin(nlohmann-json-license "${PIXCAKE_JSON_LICENSE_URL}" "${PIXCAKE_JSON_LICENSE_SHA256}")
if(NOT "${PIXCAKE_JSON_HEADER_URL}" MATCHES "/v${PIXCAKE_JSON_VERSION}/" OR
   NOT "${PIXCAKE_JSON_LICENSE_URL}" MATCHES "/v${PIXCAKE_JSON_VERSION}/")
  string(APPEND failures "JSON header and license URLs must name the locked version\n")
endif()
check_pin(tensorflow "${PIXCAKE_TENSORFLOW_SOURCE_URL}" "${PIXCAKE_TENSORFLOW_SOURCE_SHA256}")
if(NOT "${PIXCAKE_LITERT_SOURCE_URL}" MATCHES "${PIXCAKE_LITERT_COMMIT}" OR
   NOT "${PIXCAKE_TENSORFLOW_SOURCE_URL}" MATCHES "${PIXCAKE_TENSORFLOW_COMMIT}")
  string(APPEND failures "LiteRT/TensorFlow source URLs must name the locked commits\n")
endif()
foreach(model IN LISTS PIXCAKE_MODEL_LIST)
  check_pin("model ${model}" "${PIXCAKE_MODEL_${model}_URL}" "${PIXCAKE_MODEL_${model}_SHA256}")
  if("${PIXCAKE_MODEL_${model}_LICENSE}" STREQUAL "")
    string(APPEND failures "model ${model}: no licence recorded\n")
  elseif(NOT "${PIXCAKE_MODEL_${model}_LICENSE}" STREQUAL "Apache-2.0" AND "${PIXCAKE_MODEL_${model}_USE_TERMS}" STREQUAL "")
    string(APPEND failures "model ${model}: licence is not Apache-2.0 and no use terms are recorded\n")
  endif()
endforeach()
check_sha(third_party/onnxruntime/LICENSES/LICENSE.txt "${PIXCAKE_ONNXRUNTIME_SHA256_LICENSE}")
check_pin(onnxruntime "${PIXCAKE_ONNXRUNTIME_PACKAGE_URL}" "${PIXCAKE_ONNXRUNTIME_PACKAGE_SHA256}")
if(NOT "${PIXCAKE_ONNXRUNTIME_PACKAGE_URL}" MATCHES "/${PIXCAKE_ONNXRUNTIME_TAG}/")
  string(APPEND failures "ONNX Runtime package URL must name the locked tag\n")
endif()
check_pin(testdata-portrait "${PIXCAKE_TESTDATA_PORTRAIT_URL}" "${PIXCAKE_TESTDATA_PORTRAIT_SHA256}")
foreach(blockers PIXCAKE_LITERT_RELEASE_BLOCKERS PIXCAKE_MODELS_RELEASE_BLOCKERS PIXCAKE_ONNXRUNTIME_RELEASE_BLOCKERS)
  if(NOT "${${blockers}}" STREQUAL "")
    string(APPEND failures "${blockers} remain: ${${blockers}}\n")
  endif()
endforeach()

if(NOT failures STREQUAL "")
  message(FATAL_ERROR "third-party lock check failed:\n${failures}")
endif()
message(STATUS "third-party locks verified")
