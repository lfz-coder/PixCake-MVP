cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "cloud boundary: SOURCE_DIR is required")
endif()

# CLD-08: the directory service stays pure; only its separate adapter sees net.
function(check_cloud_module module allowed)
if(NOT EXISTS "${SOURCE_DIR}/services/${module}/CMakeLists.txt")
  message(FATAL_ERROR "cloud boundary: services/${module}/CMakeLists.txt is required")
endif()
file(GLOB_RECURSE cloud_sources "${SOURCE_DIR}/services/${module}/*.cpp" "${SOURCE_DIR}/services/${module}/*.hpp"
                               "${SOURCE_DIR}/services/${module}/CMakeLists.txt")
foreach(path IN LISTS cloud_sources)
  file(READ "${path}" text)
  foreach(forbidden "#include <Q" "#include \"Q" "Qt6::" "Qt5::" "Qt::" "QOpenGL"
                    "sqlite3.h" "SQLite::" "jpeglib.h" "png.h" "opencv" "OpenGL" "GL/gl.h"
                    "<CoreFoundation/" "<Foundation/" "<AppKit/" "<Security/" "<CommonCrypto/"
                    "#include \"../")
    string(FIND "${text}" "${forbidden}" found)
    if(NOT found EQUAL -1)
      message(FATAL_ERROR "cloud boundary: ${path} contains ${forbidden}")
    endif()
  endforeach()
  if(NOT module STREQUAL "net/curl")
    foreach(forbidden "curl/" "CURL::" "pixcake/net/curl_http_transport.hpp")
      string(FIND "${text}" "${forbidden}" found)
      if(NOT found EQUAL -1)
        message(FATAL_ERROR "cloud boundary: ${path} contains concrete transport ${forbidden}")
      endif()
    endforeach()
  endif()
  if((NOT module STREQUAL "cloud_transport" AND NOT module STREQUAL "cloud_sync") OR path MATCHES "/include/")
    string(FIND "${text}" "nlohmann" found)
    if(NOT found EQUAL -1)
      message(FATAL_ERROR "cloud boundary: ${path} exposes JSON outside the codec implementation")
    endif()
  endif()
  if(module STREQUAL "cloud_sync")
    string(REGEX MATCHALL "pixcake/platform/[a-z_0-9]+[.]hpp" platform_headers "${text}")
    foreach(header IN LISTS platform_headers)
      if(path MATCHES "/include/" OR NOT header STREQUAL "pixcake/platform/sha256.hpp")
        message(FATAL_ERROR "cloud boundary: ${path} exposes or uses an unsupported platform adapter")
      endif()
    endforeach()
  endif()
  if(path MATCHES "/include/")
    string(FIND "${text}" "curl/" found)
    if(NOT found EQUAL -1)
      message(FATAL_ERROR "cloud boundary: ${path} exposes a curl header")
    endif()
  endif()
  string(REGEX MATCHALL "pixcake/[a-z_]+/" includes "${text}")
  foreach(included IN LISTS includes)
    if(NOT included MATCHES "^pixcake/(${allowed})/$")
      message(FATAL_ERROR "cloud boundary: ${path} includes ${included}")
    endif()
  endforeach()
  if(path MATCHES "CMakeLists.txt$")
    string(REGEX MATCHALL "pixcake_[a-z_]+" targets "${text}")
    foreach(target IN LISTS targets)
      if(NOT target MATCHES "^pixcake_(${allowed}|warnings)$")
        message(FATAL_ERROR "cloud boundary: ${path} links ${target}")
      endif()
    endforeach()
  endif()
endforeach()
endfunction()
check_cloud_module(cloud "cloud|account|support")
check_cloud_module(cloud_transport "cloud_transport|cloud|account|net|support")
check_cloud_module(cloud_sync "cloud_sync|cloud_sync_impl|project_session|net|support|editdoc|layerdoc|project|platform|platform_digest")
check_cloud_module(net/curl "net|http_curl|support")
message(STATUS "cloud dependencies ok")
