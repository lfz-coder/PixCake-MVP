cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED SOURCE_DIR OR NOT DEFINED BINARY_DIR)
  message(FATAL_ERROR "SOURCE_DIR and BINARY_DIR required")
endif()
set(checker "${SOURCE_DIR}/tests/arch/check_cloud_dependencies.cmake")
function(check_case name module source cmake_body accepted)
  # The repo-wide gate excludes /build/ from source scans. Keep deliberately
  # forbidden fixtures there so parallel gate tests never mistake them for code.
  set(fixture "${BINARY_DIR}/build/cloud-arch-fixtures/${name}")
  file(MAKE_DIRECTORY "${fixture}/services/cloud" "${fixture}/services/cloud_transport"
                      "${fixture}/services/cloud_sync" "${fixture}/services/net/curl")
  file(WRITE "${fixture}/services/cloud/CMakeLists.txt" "${cloud_links}")
  file(WRITE "${fixture}/services/cloud_transport/CMakeLists.txt" "${transport_links}")
  file(WRITE "${fixture}/services/cloud_sync/CMakeLists.txt" "${sync_links}")
  file(WRITE "${fixture}/services/net/curl/CMakeLists.txt" "${curl_links}")
  set(probe "probe.cpp")
  if(ARGC GREATER 5)
    set(probe "${ARGV5}")
    file(MAKE_DIRECTORY "${fixture}/services/${module}/include")
  endif()
  file(WRITE "${fixture}/services/${module}/${probe}" "${source}")
  file(WRITE "${fixture}/services/${module}/CMakeLists.txt" "${cmake_body}")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${fixture}" -P "${checker}"
                  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(accepted AND NOT result EQUAL 0)
    message(FATAL_ERROR "positive fixture rejected: ${output}${error}")
  elseif(NOT accepted)
    if(result EQUAL 0 OR NOT error MATCHES "cloud boundary:")
      message(FATAL_ERROR "negative fixture ${name} did not fail for cloud boundary: ${output}${error}")
    endif()
  endif()
endfunction()
set(cloud_links "target_link_libraries(pixcake_cloud PUBLIC pixcake_account pixcake_support pixcake_warnings)")
set(transport_links "target_link_libraries(pixcake_cloud_transport PUBLIC pixcake_cloud pixcake_net pixcake_support pixcake_warnings)")
