# Code ported from PhotoCraft (MIT, elected from MIT OR Apache-2.0) must ship with the MIT
# permission notice, and every ported file must point to it.  Run with -DSOURCE_DIR=<repo>.
set(license "${SOURCE_DIR}/third_party/photocraft-LICENSES/LICENSE-MIT")
if(NOT EXISTS "${license}")
  message(FATAL_ERROR "missing ${license}")
endif()
file(READ "${license}" text)
foreach(needle "Permission is hereby granted" "ArtCraft Team and the PhotoCraft contributors")
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "${license} lacks '${needle}'")
  endif()
endforeach()
foreach(ported gpu/render/src/camera_raw.cpp gpu/render/include/pixcake/gpu/camera_raw.hpp
               gpu/render/src/brightness.cpp gpu/render/include/pixcake/gpu/brightness.hpp)
  file(READ "${SOURCE_DIR}/${ported}" body)
  string(FIND "${body}" "third_party/photocraft-LICENSES/LICENSE-MIT" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "${ported} does not point to the PhotoCraft licence text")
  endif()
endforeach()
